# Copy to apps/web/.env  (cp .env.example apps/web/.env)
# Never commit .env. Values marked "docs" were read from the official docs on 2026-11-10 —
# re-check them before relying on them (links in README).

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Circle (User-Controlled Wallets + Google social login) ---------------
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com
# Circle blockchain identifier for Arc testnet (docs: developers.circle.com)
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# SCA (smart-contract account) or EOA
CIRCLE_ACCOUNT_TYPE=SCA
# App ID: curl -H "Authorization: Bearer $CIRCLE_API_KEY" https://api.circle.com/v1/w3s/config/entity
NEXT_PUBLIC_CIRCLE_APP_ID=
# Empty = PIN wallets (no Google). Set it to switch "Get started" to Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Arc testnet (docs: https://docs.arc.io/arc/references/connect-to-arc) --
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# USDC ERC-20 interface (6 decimals). Used for pay-at-venue transfers (defaults to this address);
# the escrow itself is paid in native USDC (msg.value).
USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_FAUCET_URL=https://faucet.circle.com

# --- Escrow ----------------------------------------------------------------
# Filled by `npm run deploy:arc` (apps/web) — see README
ESCROW_ADDRESS=
# Operator: relays check-ins (pays gas) and refunds to the payer. It cannot release a stop
# without the traveller's code. TESTNET ONLY — never a mainnet key. Fund it from the faucet.
OPERATOR_PRIVATE_KEY=

# --- Map -------------------------------------------------------------------
# Optional MapLibre style URL. Empty = OpenFreeMap "liberty" (OSM data, no key).
# Or NEXT_PUBLIC_MAP_TILE_URL=https://…/{z}/{x}/{y}.png for a raster provider.
NEXT_PUBLIC_MAP_STYLE_URL=
# Vector tiles used for places (OpenMapTiles poi layer)
OFM_TILEJSON_URL=https://tiles.openfreemap.org/planet
# Overpass (opening hours only), comma-separated, tried in order with failover
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
# Optional Photon geocoder (server-side fallback). Empty = off (public photon.komoot.io blocks some networks).
PHOTON_URL=
# Weather (keyless)
OPEN_METEO_URL=https://api.open-meteo.com

DATABASE_URL=file:./dev.db

# Optional: protects POST /api/refund {"mode":"sweep"} when set
CRON_SECRET=
