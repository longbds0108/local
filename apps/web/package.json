{
  "name": "hedgora-travel-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "abi": "node scripts/sync-abi.mjs",
    "refund:sweep": "curl -s -X POST http://localhost:3000/api/refund -H 'content-type: application/json' -d '{\"mode\":\"sweep\"}'",
    "deploy:arc": "bash scripts/deploy-arc.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@circle-fin/w3s-pw-web-sdk": "1.1.11",
    "@mapbox/vector-tile": "3.0.0",
    "@prisma/client": "6.19.3",
    "html5-qrcode": "2.3.8",
    "maplibre-gl": "6.16.0",
    "next": "15.5.28",
    "opening_hours": "3.15.0",
    "pbf": "5.1.2",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
