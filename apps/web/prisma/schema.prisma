generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  circleUserId  String      @unique
  walletId      String?
  walletAddress String?
  email         String?
  itineraries   Itinerary[]
  createdAt     DateTime    @default(now())
}

model Merchant {
  id            String @id
  name          String
  osmId         String @unique
  walletAddress String
  /// The venue takes bookings and asks for a deposit → its stops are prepaid into the escrow.
  /// Otherwise travellers pay it directly when they arrive (scan its QR).
  prepay        Boolean @default(false)
  stops         Stop[]
}

model Itinerary {
  id             String       @id @default(cuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  title          String
  startAt        DateTime
  endAt          DateTime
  partySize      Int
  totalUsdc      Decimal // 6 decimals
  status         String // DRAFT | PAID | COMPLETED | REFUNDED | PARTIAL
  depositTxHash  String?
  paidAt         DateTime?
  onchainId      String? // bytes32 used in the contract
  deadline       Int? // unix seconds, passed to deposit()
  payerAddress   String?
  profile        String       @default("driving")
  geometry       String? // GeoJSON LineString (JSON) for the route
  stops          Stop[]
  chatSessions   ChatSession[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Stop {
  id            String    @id @default(cuid())
  itineraryId   String
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  order         Int
  osmId         String
  name          String
  lat           Float
  lon           Float
  category      String
  arriveAt      DateTime
  durationMin   Int
  travelMin     Int // from previous point (first stop: from user's start location)
  priceUsdc     Decimal
  priceSource   String    @default("seed") // seed | estimate
  note          String?
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  qrSecret      String // legacy (v1 HMAC vouchers); unused since escrow v2
  codeHash      String? // keccak256 of the check-in code; the code itself never leaves the traveller's device
  // How this stop is paid:
  //   ESCROW — prepaid into the escrow, released to the venue with the check-in code
  //   VENUE  — paid directly to the venue's wallet on arrival (traveller scans the venue QR)
  //   SELF   — venue isn't a Toura partner: estimate only, traveller pays it themselves
  //   NONE   — free
  payMode       String    @default("ESCROW")
  paidUsdc      Decimal? // VENUE: amount actually paid at the venue
  payFromBlock  Int? // VENUE: chain block when the payment was started (where to look for the transfer)
  status        String // FREE | PENDING | CHECKED_IN | RELEASED | REFUNDED | SKIPPED (VENUE stop never paid)
  onchainIndex  Int? // index in the escrow's stops[] (only paid stops are escrowed)
  releaseTx     String?
  refundTx      String?
  refundedAt    DateTime?
  checkedInAt   DateTime?
}

// Full Claude conversation for a chat (append-only, incl. tool calls), so edits
// like "bỏ hải đăng" can modify the existing DRAFT itinerary.
model ChatSession {
  id          String     @id @default(cuid())
  messages    String     @default("[]") // JSON array of Anthropic message params
  itineraryId String?
  itinerary   Itinerary? @relation(fields: [itineraryId], references: [id])
  startLat    Float?
  startLon    Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
